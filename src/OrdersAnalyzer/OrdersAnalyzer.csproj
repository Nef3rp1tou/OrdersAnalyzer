<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy the data file next to the .exe so the app works no matter where it is started from. -->
    <None Include="..\..\orders.json" Link="orders.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
